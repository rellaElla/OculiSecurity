{
  "name": "@oculi-security/gateway",
  "version": "0.1.0",
  "description": "Oculi Security Gateway — policy-enforcing reverse proxy for MCP tool calls",
  "private": true,
  "bin": {
    "oculi": "dist/cli.js"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "tsc --noEmit",
    "hook": "tsx src/cli.ts"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/static": "^7.0.4",
    "axios": "^1.7.2",
    "better-sqlite3": "^9.6.0",
    "fastify": "^4.28.1",
    "jsonwebtoken": "^9.0.2",
    "uuid": "^10.0.0",
    "yaml": "^2.4.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.10",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.10",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^10.0.0",
    "@vitest/coverage-v8": "^1.6.0",
    "supertest": "^7.0.0",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
    "vitest": "^1.6.0"
  }
}
