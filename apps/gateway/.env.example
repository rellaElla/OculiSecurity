# Gateway Configuration — copy to .env and edit

# Server
PORT=3000
LOG_LEVEL=info

# JWT — CHANGE THIS IN PRODUCTION (min 32 chars)
JWT_SECRET=dev-secret-change-in-production-min32chars!!

# OPA — set OPA_ENABLED=false to use built-in fallback policy (no Docker needed)
OPA_URL=http://localhost:8181
OPA_ENABLED=true

# SQLite audit log
DB_PATH=./data/audit.db

# Set to true to store raw args JSON in audit log (default: hash only)
STORE_FULL_ARGS=false

# Rate limiting (token bucket per actor:tool)
RATE_LIMIT_CAPACITY=10
RATE_LIMIT_REFILL=2

# Upstream base URLs (used when not running via Docker Compose)
FS_SERVER_URL=http://localhost:3001
HTTP_SERVER_URL=http://localhost:3002
